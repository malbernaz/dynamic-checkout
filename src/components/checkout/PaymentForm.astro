---
import { CreditCard, Lock } from "@lucide/astro";
import SectionHeader from "../ui/SectionHeader.astro";
import FormField from "../ui/FormField.astro";
---

<div class="rounded-2xl bg-bg-card p-5 lg:p-7 shadow-[0_2px_12px_rgba(27,58,107,0.08)]">
  <SectionHeader class="mb-6">
    <CreditCard size={20} class="text-primary" slot="leading" />
    Payment Details
  </SectionHeader>
  <div class="flex flex-col gap-4">
    <FormField label="Card Number" name="card" placeholder="4242 4242 4242 4242" disabled>
      <Lock size={16} class="text-text-muted shrink-0" />
    </FormField>
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_160px] gap-4">
      <FormField label="Expiry" name="expiry" placeholder="MM / YY" disabled />
      <FormField label="CVV" name="cvv" placeholder="123" disabled />
    </div>
  </div>
</div>
