---
import { Receipt, Tag, Truck, Shield } from "@lucide/astro";
import SectionHeader from "../ui/SectionHeader.astro";
import Divider from "../ui/Divider.astro";
import LineItem from "./LineItem.astro";
import SummaryRow from "./SummaryRow.astro";
import TotalRow from "./TotalRow.astro";
---

<div class="rounded-2xl bg-bg-card p-5 lg:p-7 shadow-[0_2px_12px_rgba(27,58,107,0.08)]">
  <SectionHeader class="mb-4">
    <Receipt size={20} class="text-primary" slot="leading" />
    Order Summary
  </SectionHeader>
  <Divider />
  <LineItem />
  <Divider />
  <div data-discount-group>
    <SummaryRow label="Subscribe & Save (15% off)" value="-$4.50" negative valueData="discount-value">
      <Tag size={16} class="text-success" slot="icon" />
    </SummaryRow>
    <Divider />
  </div>
  <SummaryRow label="Standard Shipping" value="$5.99">
    <Truck size={16} class="text-text-muted" slot="icon" />
  </SummaryRow>
  <Divider />
  <TotalRow value="$31.48" />
  <Divider />
  <div class="flex items-center gap-2.5 pt-3 text-xs text-text-muted">
    <Shield size={16} class="shrink-0 text-success" />
    <span>30-day money-back guarantee. Free returns on unopened bags.</span>
  </div>
</div>
