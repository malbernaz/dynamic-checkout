---
interface Props {
  label?: string;
  value: string;
}

const { label = "Total", value } = Astro.props;
---

<div class="flex items-center justify-between py-3">
  <span class="text-lg font-semibold text-text-primary">{label}</span>
  <span class="text-2xl font-semibold text-primary" data-total-value>{value}</span>
</div>
