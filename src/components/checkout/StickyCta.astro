---
import { Lock } from "@lucide/astro";

interface Props {
  label?: string;
}

const { label = "Subscribe & Save — $31.48" } = Astro.props;
---

<button
  type="button"
  data-cta
  class="fixed inset-x-0 bottom-0 z-50 flex lg:hidden items-center justify-center gap-2 border-t border-primary bg-primary px-4 py-3 shadow-[0_-2px_12px_rgba(0,0,0,0.06)]"
>
  <Lock size={16} class="text-text-on-primary" />
  <span class="text-sm font-semibold text-text-on-primary" data-cta-label>{label}</span>
</button>
