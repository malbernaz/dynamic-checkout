---
import { Dog } from "@lucide/astro";
import CartItem from "./CartItem.astro";

interface Props {
  name?: string;
  subtitle?: string;
  price?: string;
  quantity?: number;
}

const props = Astro.props;
---

<div class="flex gap-5 items-start">
  <div class="shrink-0 flex items-center justify-center w-18 h-18 lg:w-30 lg:h-30 rounded-xl bg-accent-soft/40">
    <Dog size={32} class="text-primary lg:hidden" />
    <Dog size={56} class="text-primary hidden lg:block" />
  </div>
  <div class="flex-1 min-w-0">
    <CartItem {...props} />
  </div>
</div>
