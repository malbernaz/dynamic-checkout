---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class:list={["flex items-center gap-2", className]}>
  <slot name="leading" />
  <h2 class="text-base font-semibold text-text-primary"><slot /></h2>
  <div class="ml-auto">
    <slot name="trailing" />
  </div>
</div>
